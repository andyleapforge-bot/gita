rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // Users: own read/write for app users; full read + delete for admins
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      allow read, delete: if isAdmin();
    }

    // Shloks: publicly readable by app; full CRUD for admins
    match /shloks/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Videos: publicly readable by app; full CRUD for admins
    match /videos/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admins: each admin can read their own doc; no client-side writes
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
